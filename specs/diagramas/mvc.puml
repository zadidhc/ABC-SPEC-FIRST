@startuml
!theme plain
skinparam componentStyle uml2
skinparam packageStyle rectangle
skinparam handwritten false
skinparam classAttributeIconSize 0

title ABC Software Corp — Arquitectura Monolito Modular (Patrón MVC)

package "Presentation Layer (Controllers)" as PresentationLayer {
    class InvoiceController {
        +createInvoice(req: CreateInvoiceRequest): Response
        +issueInvoice(id: UUID, req: IssueInvoiceRequest): Response
        +getInvoiceById(id: UUID): Response
        +downloadInvoiceXml(id: UUID): FileStream
        +downloadInvoiceCdr(id: UUID): FileStream
        +downloadInvoicePdf(id: UUID): FileStream
    }

    class NoteController {
        +createNote(req: CreateNoteRequest): Response
        +issueNote(id: UUID): Response
        +getNoteById(id: UUID): Response
        +downloadNoteXml(id: UUID): FileStream
        +downloadNoteCdr(id: UUID): FileStream
    }

    class SummaryVoidController {
        +processDailySummary(req: CreateDailySummaryRequest): Response
        +sendVoidCommunication(req: CreateVoidCommunicationRequest): Response
        +getTicketStatus(ticket: String): Response
    }

    class LedgerController {
        +getSalesLedger(period: String): Response
        +getPhysicalInventoryLedger(period: String): Response
    }

    class MigrationController {
        +createMigrationBatch(req: CreateMigrationBatchRequest): Response
        +getMigrationBatchById(batchId: UUID): Response
        +getTraceabilityByLegacyDocument(legacyDocNumber: String): Response
    }

    class InventoryController {
        +getInventoryMovements(filter: FilterDTO): Response
        +getStockLevels(): Response
    }
}

package "Application Services Layer" as ApplicationLayer {
    class InvoicingService {
        -invoiceRepository: IInvoiceRepository
        -ublGenerator: IUblGeneratorPort
        -xmlValidator: IXmlValidatorPort
        -signatureService: IDigitalSignaturePort
        -sunatOseClient: ISunatOsePort
        -documentStorageService: IDocumentStorageService
        -inventoryService: InventoryService
        +registerAndValidate(dto: CreateInvoiceRequest): Invoice
        +issueInvoice(invoiceId: UUID): IssuanceResult
        +getInvoiceById(invoiceId: UUID): Invoice
    }

    class NoteService {
        -noteRepository: INoteRepository
        -invoiceRepository: IInvoiceRepository
        -ublGenerator: IUblGeneratorPort
        -xmlValidator: IXmlValidatorPort
        -signatureService: IDigitalSignaturePort
        -sunatOseClient: ISunatOsePort
        -documentStorageService: IDocumentStorageService
        +createNote(dto: CreateNoteRequest): CreditDebitNote
        +issueNote(noteId: UUID): IssuanceResult
    }

    class SummaryVoidService {
        -sunatOseClient: ISunatOsePort
        -documentStorageService: IDocumentStorageService
        +sendDailySummary(dto: CreateDailySummaryRequest): TicketResponse
        +sendVoidCommunication(dto: CreateVoidCommunicationRequest): TicketResponse
        +checkTicket(ticket: String): TicketStatusResponse
    }

    class LedgerService {
        -invoiceRepository: IInvoiceRepository
        -inventoryMovementRepository: IInventoryMovementRepository
        +generateSalesLedger(period: String): SalesLedgerPeriodResponse
        +generatePhysicalInventory(period: String): PhysicalInventoryPeriodResponse
    }

    class MigrationService {
        -migrationBatchRepository: IMigrationBatchRepository
        -inventoryService: InventoryService
        -productRepository: IProductRepository
        +processBatch(dto: CreateMigrationBatchRequest): MigrationBatch
        +getBatchStatus(batchId: UUID): MigrationBatch
    }

    class InventoryService {
        -inventoryMovementRepository: IInventoryMovementRepository
        +registerMovement(mov: InventoryMovement): void
        +getKardexRecords(): List<InventoryMovement>
    }
}

package "Domain Layer (Entities & Invariants)" as DomainLayer {
    class Invoice {
        +series: String
        +number: Integer
        +status: DocumentStatus
        +calculateTotals(): void
        +validateTaxInvariants(): void
    }
    class CreditDebitNote {
        +noteTypeCode: String
        +referencedDocumentSeriesNumber: String
        +discrepancyCode: String
        +calculateTotals(): void
    }
    class DocumentItemLine {
        +calculateSubtotal(): void
        +calculateTaxes(): void
    }
    class InventoryMovement {
        +type: MovementType
        +quantity: Decimal
        +referenceDocNumber: String
    }
    class MigrationBatch {
        +processRow(rawJson: String): MigrationRecord
    }
    class MigrationRecord {
        +rowStatus: RowStatus
    }
}

package "Decoupling Interfaces (Business Ports / SPI)" as InterfaceLayer {
    interface IInvoiceRepository {
        +save(invoice: Invoice): Invoice
        +findById(id: UUID): Invoice
        +getNextCorrelative(series: String): Integer
    }

    interface INoteRepository {
        +save(note: CreditDebitNote): CreditDebitNote
        +findById(id: UUID): CreditDebitNote
        +getNextCorrelative(series: String): Integer
    }

    interface IInventoryMovementRepository {
        +save(movement: InventoryMovement): InventoryMovement
        +findByReference(type: String, docNumber: String): List<InventoryMovement>
    }

    interface IMigrationBatchRepository {
        +save(batch: MigrationBatch): MigrationBatch
        +findById(id: UUID): MigrationBatch
    }

    interface IProductRepository {
        +findBySku(sku: String): Product
        +save(product: Product): Product
    }

    interface IUblGeneratorPort {
        +generateInvoiceXml(invoice: Invoice): String
        +generateNoteXml(note: CreditDebitNote): String
    }

    interface IXmlValidatorPort {
        +validateAgainstXsd(xmlContent: String, xsdSchema: String): Boolean
    }

    interface IDigitalSignaturePort {
        +signXml(xmlContent: String, certKeyId: String): String
        +extractDigest(signedXml: String): String
    }

    interface ISunatOsePort {
        +sendBill(zipContent: byte[], fileName: String): CdrResponse
        +sendSummary(zipContent: byte[], fileName: String): TicketResponse
        +getStatus(ticket: String): CdrResponse
    }

    interface IDocumentStorageService {
        +storeDocument(path: String, content: byte[]): String
        +retrieveDocument(path: String): byte[]
    }
}

package "Infrastructure Layer (Persistence & Adapters)" as InfrastructureLayer {
    class SqlInvoiceRepository implements IInvoiceRepository
    class SqlNoteRepository implements INoteRepository
    class SqlInventoryMovementRepository implements IInventoryMovementRepository
    class SqlMigrationBatchRepository implements IMigrationBatchRepository
    class SqlProductRepository implements IProductRepository
    class UblXsdGeneratorAdapter implements IUblGeneratorPort
    class LxmlXsdValidatorAdapter implements IXmlValidatorPort
    class XmlDsigEnvelopedSignerAdapter implements IDigitalSignaturePort
    class SoapSunatOseClientAdapter implements ISunatOsePort
    class LocalFileSystemStorageAdapter implements IDocumentStorageService
}

' Relaciones de capas
InvoiceController --> InvoicingService
NoteController --> NoteService
SummaryVoidController --> SummaryVoidService
LedgerController --> LedgerService
MigrationController --> MigrationService
InventoryController --> InventoryService

InvoicingService --> IInvoiceRepository
InvoicingService --> IUblGeneratorPort
InvoicingService --> IXmlValidatorPort
InvoicingService --> IDigitalSignaturePort
InvoicingService --> ISunatOsePort
InvoicingService --> IDocumentStorageService
InvoicingService --> InventoryService
InvoicingService --> Invoice

NoteService --> INoteRepository
NoteService --> IInvoiceRepository
NoteService --> IUblGeneratorPort
NoteService --> IXmlValidatorPort
NoteService --> IDigitalSignaturePort
NoteService --> ISunatOsePort
NoteService --> IDocumentStorageService
NoteService --> CreditDebitNote

SummaryVoidService --> ISunatOsePort
SummaryVoidService --> IDocumentStorageService

LedgerService --> IInvoiceRepository
LedgerService --> IInventoryMovementRepository

MigrationService --> IMigrationBatchRepository
MigrationService --> InventoryService
MigrationService --> IProductRepository
MigrationService --> MigrationBatch

InventoryService --> IInventoryMovementRepository
InventoryService --> InventoryMovement

Invoice *-- DocumentItemLine
CreditDebitNote *-- DocumentItemLine

@enduml
